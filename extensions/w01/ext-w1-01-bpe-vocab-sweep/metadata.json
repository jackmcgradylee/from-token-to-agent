  "hardware": "CPU-only (Jetson Nano, no CUDA)",
  "hypothesis": "bytes/token grows sublinearly with vocab; once merges are saturated, more target vocab buys no compression.",
  "method": {
    "tokenizer": "src/token_to_agent/from_scratch/tokenizer/bpe.py:BPETokenizer (byte-level, min_pair_freq=2)",
    "corpus": "experiments/w01/exp-001-char-word-bpe-comparison/samples.txt replicated 30x (~21 KB)",
    "eval_set": "## eval section of the same samples.txt (5 held-out lines, 272 bytes)",
    "sweep": "target_vocab_size in {260, 512, 1024, 2048, 4096}",
    "metrics": ["actual_vocab", "num_merges", "train_seconds", "eval_tokens", "bytes_per_token", "eval_unk_count"]
  },
  "results": {
    "table": [
      {"target_vocab": 260, "actual_vocab": 260, "merges": 0, "train_s": 0.015, "eval_tokens": 272, "bpt": 1.000, "unk": 0},
      {"target_vocab": 512, "actual_vocab": 512, "merges": 252, "train_s": 0.149, "eval_tokens": 224, "bpt": 1.214, "unk": 0},
      {"target_vocab": 1024, "actual_vocab": 530, "merges": 270, "train_s": 0.153, "eval_tokens": 224, "bpt": 1.214, "unk": 0},
      {"target_vocab": 2048, "actual_vocab": 530, "merges": 270, "train_s": 0.148, "eval_tokens": 224, "bpt": 1.214, "unk": 0},
      {"target_vocab": 4096, "actual_vocab": 530, "merges": 270, "train_s": 0.149, "eval_tokens": 224, "bpt": 1.214, "unk": 0}
    ],
    "saturation_target": 1024,
    "saturation_actual_vocab": 530,
    "best_bpt": 1.214,
    "best_bpt_target_vocab": 512
  },
  "conclusion": "On this 21 KB corpus, BPE saturates at actual_vocab=530. Asking for target_vocab >= 1024 yields no additional merges and no additional compression — the trainer's min_pair_freq=2 loop simply terminates early. Best bytes/token (1.214) is achieved at target_vocab=512; everything beyond is free entropy (larger embedding tables, identical downstream behavior).",
